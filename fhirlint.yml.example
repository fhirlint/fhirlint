# fhirlint.yml — project-level configuration for fhirlint
# Place this file in your project root as fhirlint.yml or .fhirlint.yml
# CLI flags always take precedence over values in this file.

# Minimum severity to display: information | warning | error
severity: warning

# Exit non-zero when issues at this level or above are found: error | warning | never
fail-on: error

# Exit non-zero when warning count exceeds N (ratchet pattern; omit or set to -1 to disable)
# max-warnings: 10

# FHIR version to validate against: 4.0.1 | 4.3.0 | 5.0.0
fhir-version: 4.0.1

# Profile aliases or URLs (repeatable)
# See: fhirlint profiles
profile:
  # - kbv-basis
  # - mii
  # - diga

# Per-resource-type or per-filename-glob profile mapping.
# Keys are FHIR resource type names or gitignore-style filename globs.
# Values are one or more profile URLs automatically added for matching files.
# profile-map:
#   Patient: http://hl7.org/fhir/us/core/StructureDefinition/us-core-patient
#   Medication:
#     - https://fhir.kbv.de/StructureDefinition/KBV_PR_Base_Medication|1.5.0
#   "tests/fixtures/de-*.json": https://fhir.kbv.de/StructureDefinition/KBV_PR_ERP_Bundle|1.1.0

# Implementation guide packages (repeatable)
ig:
  # - kbv.basis#1.5.0
  # - de.medizininformatikinitiative.kerndatensatz#2024.0.0

# Local FHIR CodeSystem files to load without a full IG package (repeatable)
# codesystem:
#   - ./codesystems/internal-drugs.json

# Local FHIR ValueSet files to load without a full IG package (repeatable)
# valueset:
#   - ./valuesets/internal-drug-valueset.json

# Output format: terminal | json | html | junit | sarif | markdown | codeclimate (repeatable)
format:
  - terminal

# Output file for json/html reports (stdout if omitted)
# output: fhir-report.json

# JSONPath fields to remove before validating (repeatable)
ignore:
  # - "$.meta.tag"
  # - "$.text"

# Exclude files or directories from validation (gitignore-style patterns, repeatable).
# Also supported via .fhirlintignore in the project root.
# exclude:
#   - tests/fixtures/invalid/**
#   - src/generated/*.json
#   - vendor/

# Best-practice constraint handling: ignore | hint | warning | error
# ignore  — silences dom-6 and all other best-practice constraints
# hint    — reported as informational hints
# warning — JAR default
# error   — escalates to errors, fails build with fail-on: error
# best-practice: ignore

# Terminology cache directory (pass n/a to disable)
# Useful with actions/cache in CI to reuse terminology responses across runs
# tx-cache: .fhirlint-tx-cache/

# Write a log of all terminology server HTTP requests to a file (for debugging and auditing)
# tx-log: tx.log

# Locale for validation messages (Java locale format: de, de-DE, fr, etc.)
# Default: system locale
# locale: de

# Suppress warnings about example.org and similar placeholder URLs
# Useful for test fixtures and documentation examples
# allow-example-urls: true

# Jurisdiction for country-specific bindings (default: derived from locale)
# Relevant for national profiles such as KBV / MII / DiGA
# jurisdiction: urn:iso:std:iso:3166#DE

# Downgrade coded-display mismatch errors to warnings
# Reduces noise when display strings drift from the terminology server
# display-issues-are-warnings: true

# Load message translations from .po files at runtime (repeatable)
# Overrides the validator's built-in messages, e.g. for German output
# po:
#   - validator-messages-de.po

# Suppress warning when terminology server URL uses HTTP instead of HTTPS
# Only set this for local or internal servers where encryption is not required
# allow-insecure-tx: true

# Watch mode: re-validate on file changes (single = changed files only, all = all files)
# watch: single

# Polling interval for watch mode in milliseconds (default: JAR default ~1000ms)
# watch-interval: 500

# Cache validation results per file hash (opt-in)
# Skips re-validating files that haven't changed since the last run.
# Combine with actions/cache in CI for faster repeated runs.
# cache: true
# cache-dir: .fhirlint-cache/

# Suppression rules — silence known/accepted validation issues
# Each rule silences matching issues from output and exit-code calculation.
# Use --show-suppressed to display them with a muted label instead of hiding.
# suppress:
#   - messageId: Measure_M_POPULATIONIDENTIFIER   # suppress by HL7 message ID
#   - constraint: dom-6                           # suppress by FHIR constraint ID
#   - expression: MedicationRequest.intent        # suppress all issues on a field path
#   - expression: Patient.text
#     severity: warning                           # optional: only suppress at this severity
#   - pattern: ".*example\\.org.*"               # suppress by regex match on message text
#   - pattern: "Unknown extension.*"
#     severity: warning                           # optional: only at this severity

# Custom lint rules — assert project-specific FHIRPath expressions on every
# resource. A resource that fails the assertion produces a finding (message ID
# "rule:<id>"). Rules run in-process against JSON (R4/R4B/R5); XML is skipped.
# Alternatively load them from a file with: --rules-file lint-rules.yml
# See docs/rules.md for the supported FHIRPath subset.
# rules:
#   - id: patient-needs-mrn
#     resource: Patient                           # optional resourceType filter
#     assert: "identifier.where(system='http://hospital.example/mrn').exists()"
#     message: "Patient is missing an MRN identifier"
#     severity: error                             # error | warning | information (default: error)
#   - id: has-name
#     assert: "name.exists()"
#     severity: warning

# Built-in style/naming lint rules — opt-in convention checks the validator does
# not enforce. Each finding uses message ID "lint:<rule>" and behaves like any
# other issue. Rules run on JSON (R4/R4B/R5); XML is skipped.
# See docs/lint-rules.md for the full list.
# lint:
#   id-kebab-case: warning                        # resource id should be lowercase kebab-case
#   profile-name-pascalcase: warning              # StructureDefinition.name should be PascalCase
#   canonical-url-pattern:                        # canonical url must start with a base
#     severity: error
#     base: "https://example.org/fhir/"

# Validate each entry.resource inside a FHIR Bundle as a standalone resource.
# The Bundle itself is still validated (structure); entry validation is additive.
# Works for all Bundle types (transaction, batch, collection, document, searchset).
# bundle-entries: true

# Skip files that are not FHIR resources instead of reporting them as errors.
# Useful when fhirlint is pointed at a whole repo, or driven by tooling that
# passes every changed file (pre-commit). A file that fails to parse is still
# validated and still fails — only files that parse cleanly and carry no
# resourceType (JSON) or FHIR namespace (XML) are dropped.
# skip-non-fhir: true

# Extra arguments passed straight through to the validator JAR (repeatable).
# An escape hatch for validator options fhirlint does not model yet — they are
# forwarded unchecked, so a malformed argument breaks the run. Arguments that
# collide with what fhirlint manages itself (-output, -output-style, -jar) are
# rejected, because the result pipeline depends on them.
# validator-arg:
#   - -some-new-validator-flag
#   - value-for-that-flag

# Check referential integrity across the validated set (dangling references).
# Unresolved local references (relative, urn:uuid, contained #id) are errors
# (ref:unresolved); absolute references to external servers are information
# (ref:external). Runs in-process on JSON; XML is skipped. See docs/references.md.
# check-references: true

# Validate against a running warm validator server instead of a per-run JVM.
# Start one with: fhirlint serve --port 8080 --ig <package>
# The server's FHIR version/IGs/tx are fixed at its startup; see docs/daemon.md.
# server: http://localhost:8080

# Suppress per-file output for valid files — only files with issues are printed.
# The summary line is always shown. Only affects --format terminal.
# quiet: true

# Disable ANSI color output (useful for CI environments that don't support color).
# no-color: true

# Baseline file — suppress pre-existing issues and fail only on regressions.
# Generate:  fhirlint validate resources/ --generate-baseline fhirlint-baseline.json
# Use:       fhirlint validate resources/ --baseline fhirlint-baseline.json
# Or set here to avoid repeating the flag on every run:
# baseline: fhirlint-baseline.json

# IG lock file — pin exact package versions for reproducible CI builds.
# Run once with --lock to create/update fhirlint.lock:
#   fhirlint validate --lock
# Commit fhirlint.lock to version control. On subsequent runs (without --lock)
# fhirlint verifies cached packages against the recorded SHA256 hashes.

# Per-glob overrides — apply different rules to specific files or directories.
# Overrides are matched in order; later entries win on scalar conflicts (best-practice).
# Slice fields (ig, profile, suppress) are appended to the global values.
# Files not matching any override use the global config.
#
# Overridable fields:
#   ig            — appended to global IGs (separate JVM invocation per unique combination)
#   profile       — appended to global profiles
#   best-practice — replaces global best-practice (ignore | hint | warning | error)
#   severity      — hides issues below this level for matching files (information | warning | error | fatal)
#   fail-on       — set to "never" so matching files never cause a non-zero exit code
#   suppress      — additional suppress rules, same format as the global suppress list
#
# overrides:
#   - files: ["src/fhir/kbv/**"]
#     ig:
#       - kbv.basis#1.5.0
#     profile:
#       - https://fhir.kbv.de/StructureDefinition/KBV_PR_ERP_Bundle|1.1.0
#
#   - files: ["tests/fixtures/legacy/**"]
#     severity: error            # only fail on hard errors in legacy fixtures
#     suppress:
#       - messageId: UNKNOWN_CODESYSTEM
#
#   - files: ["tests/fixtures/invalid/**"]
#     fail-on: never             # intentionally invalid — never block CI
